{
  "name": "readability-kit-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p packages/javascript/tsconfig.json",
    "verify:upstream": "node tools/verify-upstream.mjs",
    "test": "bun run build && bun run verify:upstream && node --test packages/javascript/test/*.test.mjs tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:upstream": "mocha \"vendor/mozilla/test/test-*.js\" --reporter dot",
    "compare": "node tools/compare-upstream.mjs",
    "check": "bun run typecheck && bun run test && bun run test:upstream && bun run compare --check && bun run test:package",
    "test:package": "node tools/check-package.mjs",
    "demo": "node tools/serve-example.mjs",
    "build:wasm": "node tools/build-wasm.mjs",
    "test:wasm": "node tools/test-wasm.mjs",
    "benchmark:wasm": "node tools/benchmark-wasm-compare.mjs",
    "pack:javascript": "npm pack ./packages/javascript",
    "pack:wasm": "npm pack ./packages/wasm",
    "check:wasm": "bun run build && bun run build:wasm && bun run test:package:wasm && bun run test:wasm",
    "test:package:wasm": "node tools/check-wasm-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "js-beautify": "^2.0.3",
    "mocha": "^12.0.3",
    "sinon": "^14.0.2",
    "typescript": "^7.0.2",
    "xml-name-validator": "^5.0.0",
    "@soulteary/readability-kit": "workspace:*",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3"
  },
  "packageManager": "bun@1.4.2"
}
