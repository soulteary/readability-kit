{
  "name": "@soulteary/readability-kit",
  "version": "0.1.0",
  "description": "Portable article extraction with Chromium and Mozilla Readability, open Shadow DOM support, and sanitized output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "readability-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "README.md",
    "UPSTREAM.md",
    "PATCHES.md",
    "upstream.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "Apache-2.0 AND BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulteary/readability-kit.git",
    "directory": "packages/javascript"
  },
  "bugs": {
    "url": "https://github.com/soulteary/readability-kit/issues"
  },
  "homepage": "https://github.com/soulteary/readability-kit#readme",
  "keywords": [
    "readability",
    "reader-mode",
    "article-extraction",
    "chromium",
    "mozilla",
    "shadow-dom"
  ],
  "scripts": {
    "build": "node ../../tools/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node ../../tools/check-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jsdom": "30.1.3"
  },
  "devDependencies": {
    "@readability-kit/shared": "workspace:*"
  }
}
